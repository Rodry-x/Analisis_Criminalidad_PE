      {
        "name": "_Medidas",
        "columns": [
          {
            "name": "Nombre",
            "dataType": "string",
            "sourceColumn": "Nombre",
            "isHidden": false
          }
        ],
        "measures": [
          {
            "name": "Total Denuncias",
            "expression": "SUM ( fact_denuncias[cantidad] )",
            "formatString": "#,##0"
          },
          {
            "name": "Total Desaparecidos",
            "expression": "SUM ( fact_desaparecidos[cantidad] )",
            "formatString": "#,##0"
          },
          {
            "name": "Total Producción",
            "expression": "SUM ( fact_produccion[valor] )",
            "formatString": "#,##0.00"
          },
          {
            "name": "Confianza PNP",
            "expression": "AVERAGE ( fact_victimizacion[valor] )",
            "formatString": "0.0\"%\""
          },
          {
            "name": "Producción por Unidad",
            "expression": "VAR UnidadSeleccionada = SELECTEDVALUE ( dim_variable[unidad_medida] )\nRETURN IF ( NOT ISBLANK ( UnidadSeleccionada ),\n    CALCULATE ( SUM ( fact_produccion[valor] ), dim_variable[unidad_medida] = UnidadSeleccionada ) )",
            "formatString": "#,##0.00"
          },
          {
            "name": "Población",
            "expression": "SUM ( dim_poblacion[poblacion] )",
            "formatString": "#,##0"
          },
          {
            "name": "Tasa Denuncias x100k",
            "expression": "DIVIDE ( [Total Denuncias] * 100000, [Población] )",
            "formatString": "#,##0.00"
          },
          {
            "name": "Tasa Desaparecidos x100k",
            "expression": "DIVIDE ( [Total Desaparecidos] * 100000, [Población] )",
            "formatString": "#,##0.00"
          },
          {
            "name": "Denuncias Año Anterior",
            "expression": "CALCULATE ( [Total Denuncias], SAMEPERIODLASTYEAR ( dim_fecha[fecha] ) )",
            "formatString": "#,##0"
          },
          {
            "name": "Variación Denuncias %",
            "expression": "DIVIDE ( [Total Denuncias] - [Denuncias Año Anterior], [Denuncias Año Anterior] )",
            "formatString": "0.0%"
          },
          {
            "name": "Modalidad Líder",
            "expression": "VAR T = ADDCOLUMNS ( VALUES ( dim_modalidad[modalidad] ), \"@d\", [Total Denuncias] )\nVAR M = MAXX ( T, [@d] )\nRETURN MAXX ( FILTER ( T, [@d] = M ), dim_modalidad[modalidad] )"
          }
        ],
        "partitions": [
          {
            "name": "_Medidas",
            "mode": "import",
            "source": {
              "type": "query",
              "query": "SELECT 'Medidas' AS [Nombre]"
            }
          }
        ]
      }
    ],
