  <Package
    design-time-name="Package">
    <LayoutInfo>
      <GraphLayout
        Capacity="16" xmlns="clr-namespace:Microsoft.SqlServer.IntegrationServices.Designer.Model.Serialization;assembly=Microsoft.SqlServer.IntegrationServices.Graph" xmlns:mssgle="clr-namespace:Microsoft.SqlServer.Graph.LayoutEngine;assembly=Microsoft.SqlServer.Graph" xmlns:assembly="http://schemas.microsoft.com/winfx/2006/xaml">
        <NodeLayout
          Size="200.8,41.6"
          Id="Package\SQL - Limpieza Previa DW"
          TopLeft="365.000000776989,31.3529411489885" />
        <NodeLayout
          Size="184,41.6"
          Id="Package\EPT - 10_Dimensiones"
          TopLeft="355.714286471508,122.352941069223" />
        <NodeLayout
          Size="192.8,41.6"
          Id="Package\EPT - 20_FactDenuncias"
          TopLeft="15.7142857477373,230.176470386477" />
        <NodeLayout
