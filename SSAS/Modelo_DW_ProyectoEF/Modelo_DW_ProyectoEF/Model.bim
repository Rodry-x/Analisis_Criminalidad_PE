          },
          {
            "name": "id_variable",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "id_variable"
          },
          {
            "name": "id_dependencia",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "id_dependencia"
          },
          {
            "name": "valor",
            "dataType": "double",
            "sourceColumn": "valor",
            "formatString": "#,0.00"
          },
          {
            "name": "es_anio_parcial",
            "dataType": "boolean",
            "sourceColumn": "es_anio_parcial"
          },
          {
            "name": "fecha_carga",
            "dataType": "dateTime",
            "isHidden": true,
            "sourceColumn": "fecha_carga"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/(localdb)\\MSSQLLocalDB;DW_ProyectoEF\",",
                "    dw_fact_produccion = Source{[Schema=\"dw\",Item=\"fact_produccion\"]}[Data]",
                "in",
                "    dw_fact_produccion"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Operativos Policiales",
            "expression": [
              "",
              "CALCULATE (",
              "    SUM ( fact_produccion[valor] ),",
              "    fact_produccion[es_anio_parcial] = FALSE (),",
              "    KEEPFILTERS ( dim_variable[variable] = \"OPERATIVOS\" )",
              ")"
            ]
          },
          {
            "name": "Total Detenidos",
            "expression": [
              "",
              "CALCULATE (",
              "    SUM ( fact_produccion[valor] ),",
              "    fact_produccion[es_anio_parcial] = FALSE (),",
              "    KEEPFILTERS (",
              "        dim_variable[variable] IN {",
              "            \"DETENIDOS DIVERSOS DELITOS (EXTRANJEROS)\",",
              "            \"DETENIDOS DIVERSOS DELITOS (PERUANOS)\",",
              "            \"DETENIDOS POR REQUISITORIADO\"",
              "        }",
              "    )",
              ")"
            ]
          },
          {
            "name": "Intervenciones Extranjeros",
            "expression": [
              "",
              "CALCULATE (",
              "    SUM ( fact_produccion[valor] ),",
              "    fact_produccion[es_anio_parcial] = FALSE (),",
              "    KEEPFILTERS ( dim_variable[variable] = \"INTERVENCION EXTRAJEROS (LEY MIGRATORIA)\" )",
              ")"
            ]
          },
          {
            "name": "Bandas Desarticuladas",
            "expression": [
              "",
              "CALCULATE (",
              "    SUM ( fact_produccion[valor] ),",
              "    fact_produccion[es_anio_parcial] = FALSE (),",
              "    KEEPFILTERS ( dim_variable[variable] = \"BANDAS CRIMINALES DESARTICULADAS\" )",
              ")"
            ]
          },
          {
            "name": "Organizaciones Criminales Desarticuladas",
            "expression": [
              "",
              "CALCULATE (",
              "    SUM ( fact_produccion[valor] ),",
              "    fact_produccion[es_anio_parcial] = FALSE (),",
              "    KEEPFILTERS ( dim_variable[variable] = \"ORGANIZACIONES CRIMINALES DESARTICULADAS\" )",
              ")"
            ]
          },
          {
            "name": "Kilos de Droga Incautada",
            "expression": [
              "",
              "CALCULATE (",
              "    SUM ( fact_produccion[valor] ),",
              "    fact_produccion[es_anio_parcial] = FALSE (),",
              "    KEEPFILTERS ( dim_variable[unidad_medida] = \"KILOS\" )",
              ")"
            ]
          },
          {
            "name": "Dinero Incautado Soles",
            "expression": [
              "",
              "CALCULATE (",
              "    SUM ( fact_produccion[valor] ),",
              "    fact_produccion[es_anio_parcial] = FALSE (),",
              "    KEEPFILTERS ( dim_variable[variable] = \"DINERO INCAUTADO (SOLES)\" )",
              ")"
            ]
          },
          {
            "name": "Contrabando Valorizacion Soles",
            "expression": [
              "",
              "CALCULATE (",
              "    SUM ( fact_produccion[valor] ),",
              "    fact_produccion[es_anio_parcial] = FALSE (),",
              "    KEEPFILTERS ( dim_variable[variable] = \"CONTRABANDO (VALORIZACION)\" )",
              ")"
            ]
          },
          {
            "name": "Valor Produccion Unitario",
            "expression": [
              "",
              "IF (",
              "    HASONEVALUE ( dim_variable[unidad_medida] ),",
              "    CALCULATE (",
              "        SUM ( fact_produccion[valor] ),",
              "        fact_produccion[es_anio_parcial] = FALSE ()",
              "    ),",
              "    BLANK ()",
              ")"
            ]
          }
        ]
      },
      {
        "name": "fact_victimizacion",
        "columns": [
          {
            "name": "id_fact_victimizacion",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "id_fact_victimizacion"
          },
          {
            "name": "id_tiempo",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "id_tiempo"
          },
          {
            "name": "id_departamento",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "id_departamento"
          },
          {
            "name": "id_indicador",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "id_indicador"
          },
          {
            "name": "ambito",
            "dataType": "string",
            "sourceColumn": "ambito"
          },
          {
            "name": "clasif",
            "dataType": "int64",
            "sourceColumn": "clasif"
          },
          {
            "name": "valor",
            "dataType": "double",
            "sourceColumn": "valor",
            "formatString": "0.0"
          },
          {
            "name": "es_anio_parcial",
            "dataType": "boolean",
            "sourceColumn": "es_anio_parcial"
          },
          {
            "name": "fecha_carga",
            "dataType": "dateTime",
            "isHidden": true,
            "sourceColumn": "fecha_carga"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/(localdb)\\MSSQLLocalDB;DW_ProyectoEF\",",
                "    dw_fact_victimizacion = Source{[Schema=\"dw\",Item=\"fact_victimizacion\"]}[Data]",
                "in",
                "    dw_fact_victimizacion"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Percepcion Inseguridad Promedio %",
            "expression": [
              "",
              "CALCULATE (",
              "    AVERAGE ( fact_victimizacion[valor] ),",
              "    KEEPFILTERS ( fact_victimizacion[es_anio_parcial] = FALSE () ),",
              "    KEEPFILTERS ( dim_departamento[ambito] = \"DEPARTAMENTO\" ),",
              "    KEEPFILTERS ( dim_departamento[es_nacional] = FALSE () ),",
              "    dim_indicador[indicador] = \"PORCENTAJE DE PERCEPCIÓN DE INSEGURIDAD AL CAMINAR SOLO(A) DE NOCHE EN SU ZONA O BARRIO\"",
              ")"
            ]
          },
          {
            "name": "Confianza PNP Promedio %",
            "expression": [
              "",
              "CALCULATE (",
              "    AVERAGE ( fact_victimizacion[valor] ),",
              "    KEEPFILTERS ( fact_victimizacion[es_anio_parcial] = FALSE () ),",
              "    KEEPFILTERS ( dim_departamento[ambito] = \"DEPARTAMENTO\" ),",
              "    KEEPFILTERS ( dim_departamento[es_nacional] = FALSE () ),",
              "    dim_indicador[indicador] = \"PORCENTAJE DE CONFIANZA EN LA PNP\"",
              ")"
            ]
          },
          {
            "name": "Victimizacion General Promedio %",
            "expression": [
              "",
              "CALCULATE (",
              "    AVERAGE ( fact_victimizacion[valor] ),",
              "    KEEPFILTERS ( fact_victimizacion[es_anio_parcial] = FALSE () ),",
              "    KEEPFILTERS ( dim_departamento[ambito] = \"DEPARTAMENTO\" ),",
              "    KEEPFILTERS ( dim_departamento[es_nacional] = FALSE () ),",
              "    dim_indicador[indicador] = \"PORCENTAJE DE VICTIMIZACIÓN\"",
              ")"
            ]
          },
          {
            "name": "Victimizacion Robo Promedio %",
            "expression": [
              "",
              "CALCULATE (",
              "    AVERAGE ( fact_victimizacion[valor] ),",
              "    KEEPFILTERS ( fact_victimizacion[es_anio_parcial] = FALSE () ),",
              "    KEEPFILTERS ( dim_departamento[ambito] = \"DEPARTAMENTO\" ),",
              "    KEEPFILTERS ( dim_departamento[es_nacional] = FALSE () ),",
              "    dim_indicador[indicador] = \"PORCENTAJE DE VICTIMIZACIÓN POR EL DELITO DE ROBO E INTENTO DE ROBO DE DINERO, CARTERA Y CELULAR\"",
              ")"
            ]
          },
          {
            "name": "Victimizacion Estafa Promedio %",
            "expression": [
              "",
              "CALCULATE (",
              "    AVERAGE ( fact_victimizacion[valor] ),",
              "    KEEPFILTERS ( fact_victimizacion[es_anio_parcial] = FALSE () ),",
              "    KEEPFILTERS ( dim_departamento[ambito] = \"DEPARTAMENTO\" ),",
              "    KEEPFILTERS ( dim_departamento[es_nacional] = FALSE () ),",
              "    dim_indicador[indicador] = \"PORCENTAJE DE VICTIMIZACIÓN POR ESTAFA\"",
              ")"
            ]
          },
          {
            "name": "Indicador % Promedio",
            "expression": [
              "",
              "IF (",
              "    HASONEVALUE ( dim_indicador[indicador] ),",
              "    CALCULATE (",
              "        AVERAGE ( fact_victimizacion[valor] ),",
              "        KEEPFILTERS ( fact_victimizacion[es_anio_parcial] = FALSE () ),",
              "        KEEPFILTERS ( dim_departamento[ambito] = \"DEPARTAMENTO\" ),",
              "        KEEPFILTERS ( dim_departamento[es_nacional] = FALSE () )",
              "    ),",
              "    BLANK ()",
              ")"
            ]
          },
          {
            "name": "Ranking Inseguridad Dept",
            "expression": [
              "",
              "IF (",
              "    ISINSCOPE ( dim_departamento[departamento] )",
              "        && NOT ISBLANK ( [Percepcion Inseguridad Promedio %] ),",
              "    RANKX (",
              "        FILTER (",
              "            ALL ( dim_departamento ),",
              "            dim_departamento[ambito] = \"DEPARTAMENTO\"",
              "                && dim_departamento[es_nacional] = FALSE ()",
              "        ),",
              "        [Percepcion Inseguridad Promedio %],",
              "        ,",
              "        DESC,",
              "        SKIP",
              "    )",
              ")"
            ]
          },
          {
            "name": "Ranking Menor Confianza Dept",
            "expression": [
              "",
              "IF (",
              "    ISINSCOPE ( dim_departamento[departamento] )",
              "        && NOT ISBLANK ( [Confianza PNP Promedio %] ),",
              "    RANKX (",
              "        FILTER (",
              "            ALL ( dim_departamento ),",
              "            dim_departamento[ambito] = \"DEPARTAMENTO\"",
              "                && dim_departamento[es_nacional] = FALSE ()",
              "        ),",
              "        [Confianza PNP Promedio %],",
              "        ,",
              "        ASC,",
              "        SKIP",
              "    )",
              ")"
            ]
          },
          {
            "name": "Valor Nacional Referencia %",
            "expression": [
              "",
              "IF (",
              "    HASONEVALUE ( dim_indicador[indicador] ),",
              "    CALCULATE (",
              "        AVERAGE ( fact_victimizacion[valor] ),",
              "        REMOVEFILTERS ( dim_departamento ),",
              "        dim_departamento[ambito] = \"NACIONAL\",",
              "        dim_departamento[es_nacional] = TRUE (),",
              "        KEEPFILTERS ( fact_victimizacion[es_anio_parcial] = FALSE () )",
              "    ),",
              "    BLANK ()",
              ")"
            ]
          }
        ]
      }
    ],
