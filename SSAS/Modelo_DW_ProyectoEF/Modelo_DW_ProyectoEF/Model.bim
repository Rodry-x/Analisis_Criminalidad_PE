      {
        "name": "fact_denuncias",
        "columns": [
          {
            "name": "id_fact_denuncia",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "id_fact_denuncia"
          },
          {
            "name": "id_tiempo",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "id_tiempo"
          },
          {
            "name": "id_fecha",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "id_fecha"
          },
          {
            "name": "id_ubigeo",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "id_ubigeo"
          },
          {
            "name": "id_modalidad",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "id_modalidad"
          },
          {
            "name": "cantidad",
            "dataType": "int64",
            "sourceColumn": "cantidad"
          },
          {
            "name": "es_anio_parcial",
            "dataType": "boolean",
            "sourceColumn": "es_anio_parcial"
          },
          {
            "name": "fecha_carga",
            "dataType": "dateTime",
            "isHidden": true,
            "sourceColumn": "fecha_carga"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/(localdb)\\MSSQLLocalDB;DW_ProyectoEF\",",
                "    dw_fact_denuncias = Source{[Schema=\"dw\",Item=\"fact_denuncias\"]}[Data]",
                "in",
                "    dw_fact_denuncias"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Denuncias",
            "expression": [
              "",
              "CALCULATE (",
              "    SUM ( fact_denuncias[cantidad] ),",
              "    fact_denuncias[es_anio_parcial] = FALSE ()",
              ")"
            ]
          },
          {
            "name": "Ranking Modalidad",
            "expression": [
              "",
              "IF (",
              "    ISINSCOPE ( dim_modalidad[modalidad] ) && NOT ISBLANK ( [Total Denuncias] ),",
              "    RANKX (",
              "        ALL ( dim_modalidad ),",
              "        [Total Denuncias],",
              "        ,",
              "        DESC,",
              "        SKIP",
              "    )",
              ")"
            ]
          },
          {
            "name": "% Participacion Modalidad",
            "expression": [
              "",
              "DIVIDE (",
              "    [Total Denuncias],",
              "    CALCULATE (",
              "        [Total Denuncias],",
              "        ALL ( dim_modalidad )",
              "    )",
              ")"
            ]
          },
          {
            "name": "Denuncias Anio Anterior",
            "expression": [
              "",
              "VAR AnioActual =",
              "    SELECTEDVALUE ( dim_tiempo[anio] )",
              "VAR MesesActuales =",
              "    VALUES ( dim_tiempo[mes_numero] )",
              "VAR ValorActual =",
              "    [Total Denuncias]",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( AnioActual ) && NOT ISBLANK ( ValorActual ),",
              "        CALCULATE (",
              "            [Total Denuncias],",
              "            ALL ( dim_tiempo ),",
              "            dim_tiempo[anio] = AnioActual - 1,",
              "            TREATAS ( MesesActuales, dim_tiempo[mes_numero] )",
              "        )",
              "    )"
            ]
          },
          {
            "name": "Variacion YoY Denuncias %",
            "expression": [
              "",
              "VAR Actual =",
              "    [Total Denuncias]",
              "VAR Anterior =",
              "    [Denuncias Anio Anterior]",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( Actual ) && NOT ISBLANK ( Anterior ),",
              "        DIVIDE ( Actual - Anterior, Anterior )",
              "    )"
            ]
          },
          {
            "name": "Promedio Mensual Denuncias",
            "expression": [
              "",
              "CALCULATE (",
              "    AVERAGEX (",
              "        VALUES ( dim_tiempo[periodo_label] ),",
              "        [Total Denuncias]",
              "    ),",
              "    KEEPFILTERS ( dim_tiempo[es_anual] = FALSE () )",
              ")"
            ]
          },
          {
            "name": "% Estacionalidad Mensual",
            "expression": [
              "",
              "DIVIDE (",
              "    CALCULATE (",
              "        [Total Denuncias],",
              "        KEEPFILTERS ( dim_tiempo[es_anual] = FALSE () )",
              "    ),",
              "    CALCULATE (",
              "        [Total Denuncias],",
              "        REMOVEFILTERS (",
              "            dim_tiempo[mes_numero],",
              "            dim_tiempo[mes_nombre],",
              "            dim_tiempo[mes_corto],",
              "            dim_tiempo[trimestre],",
              "            dim_tiempo[trimestre_nombre],",
              "            dim_tiempo[periodo_label]",
              "        ),",
              "        KEEPFILTERS ( dim_tiempo[es_anual] = FALSE () )",
              "    )",
              ")"
            ]
          },
          {
            "name": "Total Denuncias (2019-2025)",
            "expression": [
              "",
              "CALCULATE (",
              "    SUM ( fact_denuncias[cantidad] ),",
              "    KEEPFILTERS ( fact_denuncias[es_anio_parcial] = FALSE () ),",
              "    KEEPFILTERS ( dim_tiempo[anio] >= 2019 && dim_tiempo[anio] <= 2025 )",
              ")"
            ]
          },
          {
            "name": "Denuncias vs Desaparecidos Ratio",
            "expression": [
              "",
              "DIVIDE (",
              "    [Total Denuncias (2019-2025)],",
              "    [Total Desaparecidos]",
              ")"
            ]
          }
        ]
      },
      {
        "name": "fact_desaparecidos",
        "columns": [
          {
