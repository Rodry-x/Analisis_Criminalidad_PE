            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "id_ubigeo"
          },
          {
            "name": "id_sexo",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "id_sexo"
          },
          {
            "name": "id_rango_edad",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "id_rango_edad"
          },
          {
            "name": "id_nacionalidad",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "id_nacionalidad"
          },
          {
            "name": "cantidad",
            "dataType": "int64",
            "sourceColumn": "cantidad"
          },
          {
            "name": "es_anio_parcial",
            "dataType": "boolean",
            "sourceColumn": "es_anio_parcial"
          },
          {
            "name": "fecha_carga",
            "dataType": "dateTime",
            "isHidden": true,
            "sourceColumn": "fecha_carga"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/(localdb)\\MSSQLLocalDB;DW_ProyectoEF\",",
                "    dw_fact_desaparecidos = Source{[Schema=\"dw\",Item=\"fact_desaparecidos\"]}[Data]",
                "in",
                "    dw_fact_desaparecidos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Desaparecidos",
            "expression": [
              "",
              "CALCULATE (",
              "    SUM ( fact_desaparecidos[cantidad] ),",
              "    fact_desaparecidos[es_anio_parcial] = FALSE ()",
              ")"
            ]
          },
          {
            "name": "Total Desaparecidos Menores 18",
            "expression": [
              "",
              "CALCULATE (",
              "    [Total Desaparecidos],",
              "    KEEPFILTERS ( dim_rango_edad[es_menor_18] = TRUE () )",
              ")"
            ]
          },
          {
            "name": "% Desaparecidos Menores 18",
            "expression": [
              "",
              "DIVIDE (",
              "    [Total Desaparecidos Menores 18],",
              "    [Total Desaparecidos]",
              ")"
            ]
          },
          {
            "name": "Desaparecidos Sexo No Informado",
            "expression": [
              "",
              "CALCULATE (",
              "    [Total Desaparecidos],",
              "    KEEPFILTERS ( dim_sexo[codigo_sexo] = \"NO INFORMADO\" )",
              ")"
            ]
          },
          {
            "name": "Desaparecidos Edad No Informada",
            "expression": [
              "",
              "CALCULATE (",
              "    [Total Desaparecidos],",
              "    KEEPFILTERS ( dim_rango_edad[rango_edad] = \"NO INFORMADO\" )",
              ")"
            ]
          },
          {
            "name": "Desaparecidos No Informado",
            "expression": [
              "",
              "CALCULATE (",
              "    [Total Desaparecidos],",
              "    FILTER (",
              "        fact_desaparecidos,",
              "        RELATED ( dim_sexo[codigo_sexo] ) = \"NO INFORMADO\"",
              "            || RELATED ( dim_rango_edad[rango_edad] ) = \"NO INFORMADO\"",
              "    )",
              ")"
            ]
          },
          {
            "name": "% Participacion Perfil Desaparecidos",
            "expression": [
              "",
              "DIVIDE (",
              "    [Total Desaparecidos],",
              "    CALCULATE (",
              "        [Total Desaparecidos],",
              "        ALL ( dim_sexo ),",
              "        ALL ( dim_rango_edad )",
              "    )",
              ")"
            ]
          }
        ]
      },
      {
        "name": "fact_produccion",
        "columns": [
          {
            "name": "id_fact_produccion",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "id_fact_produccion"
          },
          {
